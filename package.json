{
  "name": "pdl-habit",
  "version": "1.0.2",
  "description": "A calm, Markdown-first habit tracker: flexible schedules, streaks, a month calendar and focused insights.",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:prod": "node scripts/build.mjs",
    "deploy": "node scripts/build.mjs --deploy",
    "preview": "node preview/build.mjs --shot",
    "audit": "node scripts/audit.mjs",
    "verify": "node scripts/audit.mjs && node scripts/verify-build.mjs && node scripts/verify-bundle.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "version": "node scripts/sync-version.mjs && git add manifest.json versions.json",
    "prepare:release": "npm run build && npm test && npm run verify",
    "publish": "node scripts/publish.mjs",
    "release": "npm run prepare:release"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "habits",
    "habit-tracker",
    "streaks",
    "markdown"
  ],
  "author": "Luong Pham",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "lucide-static": "^1.69.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuongPham16/pdl-habit.git"
  },
  "bugs": {
    "url": "https://github.com/LuongPham16/pdl-habit/issues"
  },
  "homepage": "https://github.com/LuongPham16/pdl-habit#readme"
}
