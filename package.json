{
  "name": "pdl-habit",
  "version": "1.0.1",
  "description": "A calm, Markdown-first habit tracker: flexible schedules, streaks, a month calendar and focused insights.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.js --watch",
    "build": "node scripts/build.js",
    "build:prod": "node scripts/build.js --production",
    "deploy": "node scripts/build.js --production --deploy",
    "preview": "node preview/build.mjs --shot",
    "verify": "node scripts/verify-bundle.mjs",
    "test": "node --test tests/*.test.mjs",
    "version": "node scripts/sync-version.js && git add manifest.json versions.json",
    "prepare:release": "npm run build:prod && npm test && npm run verify",
    "publish": "node scripts/publish.mjs",
    "release": "npm run build:prod && npm test && npm run verify"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "habits",
    "habit-tracker",
    "streaks",
    "markdown"
  ],
  "author": "Luong Pham",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "lucide-static": "^1.69.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuongPham16/pdl-habit.git"
  },
  "bugs": {
    "url": "https://github.com/LuongPham16/pdl-habit/issues"
  },
  "homepage": "https://github.com/LuongPham16/pdl-habit#readme"
}
