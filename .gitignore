# `main.js` is the release artifact: `npm run build` writes it at the repo root and it
# is committed, so the store's build verification can compare it with a fresh build.
# `dist/` only stages the files `npm run deploy` / `npm run publish` copy around.
dist/
node_modules/
preview/.build/
preview/*.png
preview/*.html

# OS noise
.DS_Store
Thumbs.db

# Local vault path for npm run deploy
.deploy.json

# Scratch space used while patching
.work/
